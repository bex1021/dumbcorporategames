# Local backups not meant for distribution.
# The 525 MB folder of uncompressed Mixamo originals stays on disk as a
# local safety net but doesn't belong in git. The compressed files
# (15 MB total) in public/models/ ARE tracked.
game/public/models/_originals/

# Large GLBs not currently loaded by the game. They stay on disk for
# future-phase builds (Standup, Executive Review) but exceed GitHub's
# 100 MB per-file limit and add no runtime value. Re-add or compress
# before tracking when Phase 2 or 3 wires them in.
game/public/models/Male1.glb
game/public/models/Male1_walking.glb
game/public/models/Female1_sit.glb
game/public/models/Female1_stand.glb
game/public/models/Female1_walking.glb
game/public/models/Player.glb
game/public/models/Player_Sitting.glb

# Temp / scratch
*.tmp
*.bak

# Raw Mixamo FBX drops (staging for FBX→GLB conversion; not served)
game/public/models/_mixamo_raw/
game/public/models/Player_running.glb
game/public/models/Player_running_jump.glb
